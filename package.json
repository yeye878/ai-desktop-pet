{
  "name": "ai-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-katex-fonts.cjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:custom-pixel-bg": "node scripts/verify-custom-pixel-background.cjs",
    "verify:multi-agent": "node --test scripts/verify-multi-agent.cjs",
    "verify:agent-activity": "node --test scripts/verify-agent-activity.cjs",
    "verify:markdown": "node --test scripts/verify-markdown.cjs",
    "verify:agent-activity-browser": "node scripts/verify-agent-activity-browser.cjs",
    "verify:pending-interactions": "node --test scripts/verify-pending-interactions.cjs",
    "verify:interaction-browser": "node scripts/verify-interaction-browser.cjs",
    "verify:dsh-backend": "cargo test --manifest-path src-tauri/Cargo.toml --lib dsh::tests::mock_provider -- --ignored --nocapture"
  },
  "dependencies": {
    "@lucide/vue": "^1.53.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "katex": "^0.19.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
